{
  "name": "km-storage",
  "version": "1.3.0",
  "description": "Type-safe browser storage (localStorage / sessionStorage) with Zod schema validation and optional compression.",
  "license": "MIT",
  "author": "komeilm76",
  "homepage": "https://github.com/komeilm76/km-storage#readme",
  "bugs": {
    "url": "https://github.com/komeilm76/km-storage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komeilm76/km-storage.git"
  },
  "main": "build/js/index.js",
  "module": "build/esm/index.mjs",
  "types": "build/types/index.d.ts",
  "typings": "build/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./build/types/index.d.ts",
      "require": "./build/cjs/index.cjs",
      "import": "./build/esm/index.mjs",
      "default": "./build/js/index.js"
    },
    "./esm": {
      "types": "./build/esm/index.d.mts",
      "import": "./build/esm/index.mjs"
    },
    "./js": {
      "types": "./build/js/index.d.mts",
      "default": "./build/js/index.js"
    },
    "./cjs": {
      "types": "./build/cjs/index.d.ts",
      "require": "./build/cjs/index.cjs"
    }
  },
  "files": [
    "build",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "storage",
    "localStorage",
    "sessionStorage",
    "zod",
    "typescript",
    "km-packages"
  ],
  "scripts": {
    "fix:prettier": "prettier \"src/**/*.{ts,json}\" --write && prettier \"*.json\" --write",
    "fix": "bun run fix:prettier",
    "dev": "bun --watch run ./src/index.ts",
    "build:types": "tsc",
    "build:tsup": "bun run build:types && tsup",
    "build": "bun run build:types && bun run build:tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publish-directly": "npm publish --access public",
    "auto-release": "bun run fix:prettier && bun run build && bun run test && release-it"
  },
  "dependencies": {
    "zipson": "^0.2.12",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^2.1.1",
    "release-it": "^19.2.2",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=14"
  }
}
