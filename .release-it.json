{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "hooks": {
    "before:init": ["bun run fix", "bun run build", "bun run test"]
  },
  "git": {
    "commit": true,
    "tag": true,
    "push": true,
    "commitMessage": "chore: release ( v${version} )"
  },
  "github": {
    "release": true
  },
  "npm": {
    "skipChecks": false,
    "publish": true
  }
}
